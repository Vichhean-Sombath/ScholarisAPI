# Server
PORT=3000
SERVER_URL=http://localhost:3000

# Database
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority

# Authentication
SECRET_KEY=replace-with-a-long-random-secret
ATTENDANCE_CHECKIN_TOKEN=replace-with-a-long-random-checkin-token

# System automation user used to record gateway-created payments
# Leave empty to let the application create/use the system_automation user.
SYSTEM_USER_ID=

# Stripe
STRIPE_PUBLIC_KEY=pk_test_replace_me
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Bakong KHQR
BAKONG_API_ENABLED=false
BAKONG_API_URL=https://api-bakong.nbc.gov.kh
BAKONG_API_TOKEN=replace-with-bakong-api-token
BAKONG_ACCOUNT_ID=merchant_account@bank
MERCHANT_NAME=Scholaris
MERCHANT_CITY=Phnom Penh
MERCHANT_PHONE=+85512345678
STORE_LABEL=Scholaris School

# Telegram payment notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_ID=

# Email payment receipts (optional)
EMAIL_SENDER_ADDRESS=
EMAIL_APP_PASSWORD=
